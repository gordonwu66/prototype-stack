# Each provider's models show up in the chat UI only once it is configured.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Open-weight models through any OpenAI-compatible server. Local Ollama:
# OPENWEIGHT_BASE_URL=http://localhost:11434/v1
# OPENWEIGHT_MODELS=["gpt-oss:20b","qwen3:8b"]
# Or hosted, e.g. OpenRouter:
# OPENWEIGHT_BASE_URL=https://openrouter.ai/api/v1
# OPENWEIGHT_API_KEY=
# OPENWEIGHT_MODELS=["openai/gpt-oss-120b","qwen/qwen3-235b-a22b"]

# Override model lists (JSON arrays) or add a system prompt:
# ANTHROPIC_MODELS=["claude-opus-5-5","claude-sonnet-5-5"]
# CHAT_SYSTEM_PROMPT=You are a concise assistant.

# --- Postgres (the dev RDS instance). One-time setup: infra/rds/README.md.
# Without DB_HOST, chat history stays in memory and is lost on restart.
# DB_HOST=your-instance.abc123xyz.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=prototype
# The API's role (reads and writes rows) and Alembic's role (owns the schema; `pnpm db:migrate`).
# DB_USER=app
# DB_PASSWORD=
# DB_MIGRATION_USER=app_owner
# DB_MIGRATION_PASSWORD=
# TLS, verified against the RDS CA bundle (`pnpm db:cert` downloads it).
# DB_SSLMODE=verify-full
# DB_SSL_ROOT_CERT=certs/rds-global-bundle.pem

# --- Optional: RDS IAM authentication instead of the two passwords above.
# Use an IAM user made for this app with only rds-db:connect, never root keys. Either a
# profile from ~/.aws or the access keys directly; on ECS leave both unset (task role).
# DB_IAM_AUTH=true
# AWS_REGION=us-east-1
# AWS_PROFILE=prototype-stack
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Embeddings for semantic search: any OpenAI-compatible /embeddings endpoint.
# Defaults to OpenAI's text-embedding-3-large (at 1024 dims) with OPENAI_API_KEY above.
# Without any key, search runs on BM25 alone.
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_BASE_URL=https://api.fireworks.ai/inference/v1
# EMBEDDING_API_KEY=
